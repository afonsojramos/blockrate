{
  "name": "blockrate-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*"
    ],
    "catalog": {
      "@electric-sql/pglite": "^0.5.3",
      "@types/react": "^19.2.17",
      "drizzle-kit": "^0.31.11",
      "drizzle-orm": "^0.45.3",
      "nitro": "^3.0.260903-beta",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "zod": "^4.3.6"
    }
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "bump": "bun scripts/bump.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "cd apps/web && bun run typecheck",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "precommit": "bun run check",
    "prepare": "husky"
  },
  "dependencies": {
    "nitro": "catalog:",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/bun": "latest",
    "@types/react": "catalog:",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "catalog:",
    "typescript": "^6.0.3"
  }
}
