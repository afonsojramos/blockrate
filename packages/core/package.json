{
  "name": "blockrate",
  "version": "1.1.0",
  "description": "Measure the actual block rate of third-party services caused by ad blockers and privacy tools.",
  "keywords": [
    "ad-block",
    "analytics",
    "blockrate",
    "privacy"
  ],
  "homepage": "https://blockrate.app",
  "bugs": "https://github.com/afonsojramos/blockrate/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afonsojramos/blockrate.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./dist/react/index.js"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "import": "./dist/next/index.js"
    },
    "./sveltekit": {
      "types": "./src/sveltekit/index.ts",
      "import": "./dist/sveltekit/index.js"
    },
    "./tanstack-start": {
      "types": "./src/tanstack-start/index.ts",
      "import": "./dist/tanstack-start/index.js"
    },
    "./astro": {
      "types": "./src/astro/index.ts",
      "import": "./dist/astro/index.js"
    },
    "./remix": {
      "types": "./src/remix/index.ts",
      "import": "./dist/remix/index.js"
    },
    "./nuxt": {
      "types": "./src/nuxt/index.ts",
      "import": "./dist/nuxt/index.js"
    },
    "./proxy": {
      "types": "./src/proxy/index.ts",
      "import": "./dist/proxy/index.js"
    }
  },
  "scripts": {
    "build": "nub --no-env-file ../../scripts/build-packages.ts core",
    "test": "vitest run",
    "test:smoke": "BLOCKRATE_SMOKE=1 vitest run test/probe-smoke.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "blockrate-server": "link:../server"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
