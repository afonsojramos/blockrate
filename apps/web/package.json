{
  "name": "web",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "test": "bun test",
    "test:headers": "bun scripts/check-security-headers.ts",
    "typecheck": "tsc --noEmit",
    "og": "bun run scripts/generate-og.ts",
    "start": "NODE_ENV=production bun run db:migrate && NODE_ENV=production bun .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/lib/db/migrate.ts",
    "auth:generate": "bun --bun x auth generate --output src/lib/db/auth-schema.ts -y"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@electric-sql/pglite": "catalog:",
    "@fontsource-variable/geist": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "better-auth": "1.7.7",
    "blockrate": "workspace:*",
    "blockrate-server": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "catalog:",
    "lucide-react": "^1.50.0",
    "next-themes": "^0.4.6",
    "nitro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "3.10.1",
    "resend": "^6.32.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "sugar-high": "^1.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/node": "^24.19.1",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "auth": "1.7.7",
    "drizzle-kit": "catalog:",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "wawoff2": "^2.0.1"
  }
}
